FROM vllm/vllm-openai:v0.10.2
ENTRYPOINT []

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN pip install --no-cache-dir \
    torchcodec==0.7.0 \
    gradio==5.49.1 \
    transformers-stream-generator==0.0.5 \
    accelerate==1.7.0 \
    flash-attn==2.7.4.post1 \
    datasets==4.5.0 \
    deepspeed==0.17.5 \
    evaluate==0.4.6 \
    absl-py \
    nltk \
    rouge-score \
    sacrebleu \
    anthropic \
    ujson==5.13.0 \
    openai==2.1.0 \
    peft==0.17.1 \
    scikit-learn-1.9.0 \
    wandb==0.24.1

RUN python -m nltk.downloader wordnet

COPY . /workspace/TAU-R1/

RUN pip install --no-cache-dir \
    "huggingface-hub==0.35.3"

RUN pip install --no-cache-dir -e /workspace/TAU-R1/transformers && \
    pip install --no-cache-dir -e /workspace/TAU-R1/qwen-vl-utils && \
    pip install --no-cache-dir -e /workspace/TAU-R1/trl